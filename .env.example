# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Redis Configuration (BullMQ Persistent Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration (PostgreSQL / SQLite via Prisma)
# For SQLite (zero setup): DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_scheduler?schema=public"
DATABASE_URL="file:./dev.db"

# SMTP Configuration (Ethereal Email for testing)
# Leave empty to automatically auto-create a temporary Ethereal test account on startup
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
